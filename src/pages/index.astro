---
import Hero from "../components/home/Hero.astro";
import RitualStatement from "../components/home/RitualStatement.astro";
import FeaturedCollection from "../components/home/FeaturedCollection.astro";
import QuizPromo from "../components/home/QuizPromo.astro";

import { ritualStatement } from "../data/home";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Ember Specialty Coffee"
  description="Thoughtfully sourced and carefully roasted coffee worth slowing down for."
  headerAppearance="transparent"
>
  <Hero />
  <RitualStatement
    eyebrow={ritualStatement.eyebrow}
    statement={ritualStatement.statement}
    supportingCopy={ritualStatement.supportingCopy}
  />
  <FeaturedCollection />
  <QuizPromo />
</BaseLayout>
