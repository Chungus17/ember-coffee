---
import { featuredOrigins } from "../../data/origins";

import OriginCard from "../commerce/OriginCard.astro";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const originsToDisplay = featuredOrigins.slice(0, 4);
---

<section
  class="bg-canvas py-section-sm sm:py-section"
  aria-labelledby="origin-preview-title"
>
  <Container class="space-y-10 sm:space-y-12">
    <div
      class="flex flex-col gap-6
        lg:flex-row lg:items-end lg:justify-between"
    >
      <SectionHeading
        eyebrow="From place to cup"
        title="Coffee begins with where and how it was grown."
        copy="Meet the regions, producers and processing choices that shape each Ember coffee before it reaches the roastery."
        width="standard"
        class="max-w-[52rem]"
      />

      <Button href="/origins" variant="text" class="self-start lg:self-auto">
        Explore all origins
      </Button>
    </div>

    <div
      class="grid items-stretch gap-6
        md:grid-cols-2
        xl:grid-cols-4"
    >
      {originsToDisplay.map((origin) => <OriginCard origin={origin} />)}
    </div>
  </Container>
</section>
