---
import { cn } from "../../utils/cn";

interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<span
  class={cn(
    "inline-flex min-h-7 items-center",
    "rounded-full border border-ink/15",
    "bg-canvas/75 px-3 py-1",
    "text-xs font-semibold leading-none text-ink/75",
    className,
  )}
>
  {label}
</span>
