---
import { cn } from "../../utils/cn";

interface Props {
  /**
   * Controls the maximum content width.
   */
  size?: "reading" | "content" | "site" | "wide" | "full";

  /**
   * Removes the default responsive horizontal padding.
   */
  bleed?: boolean;

  /**
   * Allows a custom HTML element when needed.
   */
  as?: "div" | "section" | "article" | "header" | "footer" | "nav";

  class?: string;
}

const {
  size = "site",
  bleed = false,
  as: Tag = "div",
  class: className,
} = Astro.props;

const sizeClasses = {
  reading: "max-w-reading",
  content: "max-w-content",
  site: "max-w-site",
  wide: "max-w-wide",
  full: "max-w-none",
};
---

<Tag
  class={cn(
    "mx-auto w-full",
    sizeClasses[size],
    !bleed && "px-4 sm:px-6 lg:px-8",
    className,
  )}
>
  <slot />
</Tag>
