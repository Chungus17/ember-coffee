---
import { cn } from "../../utils/cn";

type Variant = "primary" | "secondary" | "text" | "inverse";
type Size = "sm" | "md" | "lg";
type ButtonType = "button" | "submit" | "reset";

interface Props {
  variant?: Variant;
  size?: Size;

  /**
   * When provided, the component renders an anchor.
   * Otherwise, it renders a native button.
   */
  href?: string;

  type?: ButtonType;
  disabled?: boolean;

  /**
   * Only affects anchor buttons.
   */
  target?: "_self" | "_blank" | "_parent" | "_top";
  rel?: string;
  download?: boolean | string;

  /**
   * Useful when the link should represent the current route.
   */
  ariaCurrent?: "page" | "step" | "location" | "date" | "time" | boolean;

  class?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  disabled = false,
  target,
  rel,
  download,
  ariaCurrent,
  class: className,
} = Astro.props;

const baseClasses = cn(
  "inline-flex items-center justify-center gap-2",
  "rounded-control font-semibold",
  "transition duration-200 ease-ember",
  "focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-4",
  "select-none",
);

const variantClasses: Record<Variant, string> = {
  primary: cn(
    "bg-clay text-canvas",
    "hover:bg-cocoa",
    "active:translate-y-px active:bg-ink",
    "focus-visible:outline-clay",
  ),

  secondary: cn(
    "border border-ink bg-transparent text-ink",
    "hover:bg-ink hover:text-canvas",
    "active:translate-y-px",
    "focus-visible:outline-clay",
  ),

  text: cn(
    "rounded-none text-ink underline decoration-transparent",
    "underline-offset-4",
    "hover:text-clay hover:decoration-current",
    "active:text-cocoa",
    "focus-visible:outline-clay",
  ),

  inverse: cn(
    "bg-canvas text-ink",
    "hover:bg-oat",
    "active:translate-y-px active:bg-brand",
    "focus-visible:outline-canvas",
  ),
};

const sizeClasses: Record<Size, string> = {
  sm: "min-h-10 px-4 py-2 text-sm",
  md: "min-h-11 px-5 py-2.5 text-base",
  lg: "min-h-12 px-7 py-3 text-base",
};

const disabledClasses = cn(
  "cursor-not-allowed opacity-50",
  "pointer-events-none",
);

const classes = cn(
  baseClasses,
  variantClasses[variant],
  sizeClasses[size],
  disabled && disabledClasses,
  className,
);

const safeRel = target === "_blank" ? (rel ?? "noreferrer noopener") : rel;
---

{
  href ? (
    <a
      href={disabled ? undefined : href}
      class={classes}
      target={target}
      rel={safeRel}
      download={download}
      aria-current={ariaCurrent}
      aria-disabled={disabled ? "true" : undefined}
      tabindex={disabled ? -1 : undefined}
    >
      <slot />
    </a>
  ) : (
    <button class={classes} type={type} disabled={disabled}>
      <slot />
    </button>
  )
}
