---
import { cn } from '../../utils/cn';
import type { RoastLevel } from '../../types/product';

interface Props {
  roast: RoastLevel;
  compact?: boolean;
  class?: string;
}

const {
  roast,
  compact = false,
  class: className,
} = Astro.props;

const roastConfiguration: Record<
  RoastLevel,
  {
    label: string;
    filled: number;
  }
> = {
  light: {
    label: 'Light roast',
    filled: 1,
  },

  medium: {
    label: 'Medium roast',
    filled: 2,
  },

  dark: {
    label: 'Dark roast',
    filled: 3,
  },
};

const configuration = roastConfiguration[roast];
---

<div
  class={cn(
    'inline-flex items-center gap-2',
    className,
  )}
  aria-label={configuration.label}
>
  <span
    class="inline-flex items-end gap-0.5"
    aria-hidden="true"
  >
    {
      [1, 2, 3].map((position) => {
        const active =
          position <= configuration.filled;

        return (
          <svg
            viewBox="0 0 24 32"
            class={cn(
              compact
                ? 'h-4 w-3'
                : 'h-5 w-4',
              active
                ? 'text-clay'
                : 'text-ink/20',
            )}
            fill="currentColor"
          >
            <path
              d="
                M12 1.5
                C12.7 7 18.8 9.7 19.5 17
                C20.3 24.4 16.1 30 10.8 30
                C5.7 30 2.4 26 2.6 20.8
                C2.9 15.1 7.7 12.3 8.3 7.2
                C10.6 9.1 11.7 11 12.2 13
                C13.4 9.2 12.5 5.3 12 1.5Z
              "
            />
          </svg>
        );
      })
    }
  </span>

  <span
    class={cn(
      'font-semibold text-ink/70',
      compact
        ? 'text-xs'
        : 'text-sm',
    )}
  >
    {configuration.label}
  </span>
</div>