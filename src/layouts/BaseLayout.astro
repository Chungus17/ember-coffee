---
import SeoHead from "../components/global/SeoHead.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  lang?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  image,
  noindex = false,
  lang = "en",
  bodyClass = "",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <SeoHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />

    <!-- Google Fonts connection hints -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!--
      display=swap supplies the hosted @font-face declarations
      with appropriate font-display behavior.
    -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700&display=swap"
    />

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main-content"> Skip to main content </a>

    <!--
      Global header and announcement components will be added around this
      area during Phase 2.
    -->
    <slot name="before-main" />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <slot name="after-main" />
  </body>
</html>
