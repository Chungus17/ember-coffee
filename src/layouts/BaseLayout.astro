---
import AnnouncementBar from "../components/global/AnnouncementBar.astro";
import Footer from "../components/global/Footer.astro";
import Header from "../components/global/Header.astro";
import SeoHead from "../components/global/SeoHead.astro";
import "../styles/global.css";

type HeaderAppearance = "transparent" | "light" | "dark";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  lang?: string;
  bodyClass?: string;
  headerAppearance?: HeaderAppearance;
  showFooter?: boolean;
  showAnnouncement?: boolean;
}

const {
  title,
  description,
  image,
  noindex = false,
  lang = "en",
  bodyClass = "",
  headerAppearance = "light",
  showFooter = true,
  showAnnouncement = true,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <SeoHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />

    <!-- Google Fonts connection hints -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!--
      display=swap supplies the hosted @font-face declarations
      with appropriate font-display behavior.
    -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700&display=swap"
    />

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main-content"> Skip to main content </a>

    {showAnnouncement && <AnnouncementBar />}
    {
      headerAppearance === "transparent" ? (
        <div class="relative h-0">
          <Header appearance="transparent" />
        </div>
      ) : (
        <Header appearance={headerAppearance} />
      )
    }

    <slot name="before-main" />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    {showFooter && <Footer />}

    <slot name="after-main" />
  </body>
</html>
